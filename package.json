{
  "name": "smys-agent",
  "version": "0.1.0",
  "private": true,
  "description": "A local headless AI harness",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "npm run build && node --test dist/src/tests/application/*.test.js dist/src/tests/storage/*.test.js dist/src/tests/providers/*.test.js dist/src/tests/cli/*.test.js dist/src/tests/web-host/*.test.js dist/src/tests/web/*.test.js && npm --prefix src/apps/web test",
    "precli": "npm run build",
    "cli": "node dist/src/apps/cli/main.js",
    "presmoke:lm-studio": "npm run build",
    "smoke:lm-studio": "node dist/src/apps/cli/smoke-lm-studio.js",
    "web:host": "npm run build && node dist/src/apps/web-host/main.js"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "dependencies": {
    "better-sqlite3": "12.9.0"
  }
}
